model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

annotation PBI_QueryOrder = ["DataFolder", "dim_supplier", "dim_date", "fct_po_line_status", "fct_lead_time"]

ref table dim_supplier
ref table dim_date
ref table fct_po_line_status
ref table fct_lead_time
ref expression DataFolder
