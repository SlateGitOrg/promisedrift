		sourceColumn: actual_p50_days

	column actual_p90_days
		dataType: double
		lineageTag: 59385ac2-dd0b-5eec-a432-2b517cc1875e
		summarizeBy: sum
		sourceColumn: actual_p90_days

	measure 'Lead Time P90 Days' = ```
			MAX ( fct_lead_time[actual_p90_days] )
			```
		formatString: 0.0
		lineageTag: d7a8206d-d6e3-51ec-92ca-87527c3f3b33

	partition fct_lead_time = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fct_lead_time.csv"), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalarValues=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"supplier_id", type text}, {"quarter_label", type text}, {"quarter_start", type date}, {"lines", Int64.Type}, {"quoted_lead_days", Int64.Type}, {"actual_p50_days", type number}, {"actual_p90_days", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
