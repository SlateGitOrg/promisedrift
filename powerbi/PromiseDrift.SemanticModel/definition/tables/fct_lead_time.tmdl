table fct_lead_time
	lineageTag: 4ebd66e2-09d8-5f23-9e8f-dd5ba11882e9

	column supplier_id
		dataType: string
		lineageTag: cc5a6aa1-ad3e-5400-8a3c-74a75b7b1fd8
		summarizeBy: none
		sourceColumn: supplier_id

	column quarter_label
		dataType: string
		lineageTag: 38007263-1e0d-5244-8135-ad0721d043d5
		summarizeBy: none
		sourceColumn: quarter_label

	column quarter_start
		dataType: dateTime
		formatString: Long Date
		lineageTag: a849bd26-c86d-5086-9979-52ce45800dc6
		summarizeBy: none
		sourceColumn: quarter_start

	column lines
		dataType: int64
		lineageTag: 0be05b47-2bc8-511d-a196-37bb2531ec8c
		summarizeBy: sum
		sourceColumn: lines

	column quoted_lead_days
		dataType: int64
		lineageTag: 2894eaf7-7263-5964-b54e-0d54b23707e8
		summarizeBy: sum
		sourceColumn: quoted_lead_days

	column actual_p50_days
